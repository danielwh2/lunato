{
  "name": "lunato",
  "version": "0.1.0",
  "description": "The motion layer for AI interfaces: streamed answers, agent status, live captions and rewrites, where only the words that changed move. One function, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Belyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielwh2/lunato.git"
  },
  "homepage": "https://github.com/danielwh2/lunato#readme",
  "bugs": "https://github.com/danielwh2/lunato/issues",
  "keywords": [
    "ai",
    "llm",
    "streaming",
    "chat",
    "animation",
    "text",
    "morph",
    "number",
    "counter",
    "icon",
    "emoji",
    "flip",
    "waapi",
    "reduced-motion",
    "zero-dependency",
    "react",
    "vue",
    "svelte",
    "solid"
  ],
  "sideEffects": [
    "./dist/element.js",
    "./vault.css",
    "./vault/*.css"
  ],
  "files": [
    "dist",
    "vault.css",
    "vault.css.d.ts",
    "vault/*.css",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "element": ["./dist/element.d.ts"],
      "solid": ["./dist/solid.d.ts"],
      "vault.css": ["./vault.css.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./vault.css": {
      "types": "./vault.css.d.ts",
      "default": "./vault.css"
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p vault/tsconfig.json",
    "test": "vitest run",
    "doctor": "npx -y react-doctor@latest vault --verbose --no-telemetry --no-supply-chain --yes"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "solid-js": ">=1.8"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  }
}
