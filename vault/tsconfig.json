{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "lunato": ["../src/index.ts"],
      "@/components/lunato/*": ["./*"]
    }
  },
  "include": ["./**/*.tsx", "./env.d.ts", "../tests/vault.test.tsx"]
}
